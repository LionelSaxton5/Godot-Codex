{
  "title": "Godot-codex Editor API",
  "plugin_version": "0.2.1",
  "bridge_protocol_version": 1,
  "mcp_protocol_versions": [
    "2025-11-25",
    "2025-06-18",
    "2025-03-26"
  ],
  "mcp_protocol_note": "Pinned handshake dialect; does not implement the 2026 stateless draft. Each JSON-RPC message is one UTF-8 newline-delimited object. No Content-Length framing or HTTP listener.",
  "specification_sources": [
    "https://modelcontextprotocol.io/specification/2025-11-25/basic/transports",
    "https://modelcontextprotocol.io/specification/2025-11-25/basic/lifecycle",
    "https://modelcontextprotocol.io/specification/2025-11-25/server/tools"
  ],
  "project_selection": "--project explicit directory or GODOT_PROJECT_PATH; never current working directory or auto-discovery.",
  "ipc": {
    "directory": ".godot/ai_bridge",
    "request": "requests/<32lowercasehex>.json",
    "response": "responses/<same id>.json",
    "status": "status.json",
    "request_fields": [
      "id",
      "session_id",
      "project_root",
      "operation",
      "arguments"
    ],
    "response_fields": [
      "id",
      "session_id",
      "ok",
      "result",
      "error?"
    ],
    "heartbeat_field": "heartbeat_unix",
    "heartbeat_units": "Unix seconds",
    "session_id": "32 lowercase hex",
    "revision": "Opaque string from editor scene snapshot, not a client-generated counter",
    "request_max_bytes": 2097152,
    "response_max_bytes": 4194304,
    "script_max_utf8_bytes": 1048576,
    "default_timeout_seconds": 10,
    "stale_after_seconds": 10
  },
  "safety": [
    "All node-target writes require exact scene path, opaque revision and node identity from fresh inspection.",
    "Paths are project-local res://; traversal, symlinks, junctions and generated/internal paths are rejected.",
    "The client removes only its own request/response files. It never purges queues.",
    "Published mutation without a trustworthy response returns outcome_unknown; inspect state and never retry automatically.",
    "No eval, arbitrary methods, shell execution, authentication tokens or public listeners.",
    "Playing a scene executes trusted project code; tool descriptions require approval.",
    "Script source writes do not build C# or attach the script. Existing files require overwrite=true plus expected_sha256."
  ],
  "tools": [
    {
      "name": "godot_status",
      "operation": "status",
      "description": "Get the running editor session, fresh scene guard, engine version and supported operations.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "godot_hierarchy",
      "operation": "hierarchy",
      "description": "Inspect the edited scene tree with exact node identities. Read-only; never runs project code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "node_path": {
            "type": "string",
            "maxLength": 4096,
            "description": "Root-relative node path, '.' for the scene root. No absolute paths or '..'.",
            "minLength": 1
          },
          "max_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "godot_node_inspect",
      "operation": "node_inspect",
      "description": "Inspect one node's native properties, identity and persistent signal connections.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "node_path": {
            "type": "string",
            "maxLength": 4096,
            "description": "Root-relative node path, '.' for the scene root. No absolute paths or '..'.",
